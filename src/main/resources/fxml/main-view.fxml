<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.analyzer.ui.controller.MainController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <Label text="Локальный ИИ-Анализатор Безопасности Исходного Кода" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Button fx:id="scanButton" maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Выбрать проект для сканирования">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <SplitPane dividerPositions="0.3" focusTraversable="true" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
        <items>
            <!-- Левая колонка: Список файлов -->
            <AnchorPane>
                <children>
                    <VBox spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <children>
                            <Label text="Файлы проекта:" textFill="#7f8c8d">
                                <font>
                                    <Font name="System Bold" size="12.0" />
                                </font>
                            </Label>
                            <ListView fx:id="filesListView" VBox.vgrow="ALWAYS" />
                        </children>
                    </VBox>
                </children>
            </AnchorPane>

            <!-- Правая колонка: Детали уязвимостей -->
            <AnchorPane>
                <children>
                    <SplitPane dividerPositions="0.6" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <items>
                            <!-- Верхняя часть правой панели: Таблица -->
                            <VBox spacing="5.0">
                                <children>
                                    <Label text="Найденные уязвимости:" textFill="#cc0000">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TableView fx:id="vulnerabilitiesTable" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="titleColumn" prefWidth="180.0" text="Уязвимость" />
                                            <TableColumn fx:id="severityColumn" prefWidth="90.0" text="Критичность" />
                                            <TableColumn fx:id="linesColumn" prefWidth="80.0" text="Строки" />
                                        </columns>
                                    </TableView>
                                </children>
                            </VBox>

                            <!-- Нижняя часть правой панели: Подробное описание -->
                            <VBox spacing="5.0">
                                <children>
                                    <Label text="Детали и рекомендации по исправлению:" textFill="#2c3e50">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                    <TextArea fx:id="detailsTextArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
                                </children>
                            </VBox>
                        </items>
                    </SplitPane>
                </children>
            </AnchorPane>
        </items>
    </SplitPane>
</VBox>